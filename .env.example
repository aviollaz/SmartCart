# Plantilla de configuración. Copiar a `.env` (gitignored) y ajustar.
#
#   Copy-Item .env.example .env
#
# Lo lee src/analytics.py con load_dotenv() al importarse, así que aplica igual
# corriendo uvicorn, pytest o cualquier script. Lo que ya esté exportado en el
# entorno le GANA a este archivo.
#
# En el servidor lo consumen las unidades de systemd vía `EnvironmentFile=`
# (ops/oracle/). OJO con la diferencia: EnvironmentFile NO es un shell, parsea
# CLAVE=VALOR literal. O sea que acá NO se ponen comillas alrededor de los
# valores — quedarían adentro del valor — y a cambio las contraseñas pueden
# tener los símbolos que quieran.

# --- SmartCart Performance Analyzer ---
# El microservicio analítico (../SmartCart Performance Analyzer). Corre en 8001
# porque el 8000 lo ocupa esta API.
ANALYTICS_URL=http://localhost:8001

# Secreto compartido con el analyzer: viaja en el header X-API-Key y tiene que
# coincidir con el ANALYTICS_API_KEY de SU .env.
#
# SIN ESTA VARIABLE NO SE EMITE NINGÚN EVENTO. Es a propósito (la analítica no
# puede tumbar /optimize), pero es también la forma más fácil de terminar con un
# tablero vacío sin darse cuenta: mirá la línea "Analitica:" del arranque o
# GET / para confirmar en qué estado quedó.
ANALYTICS_API_KEY=dev-local-key-change-me

# Etiqueta que viaja en source.env y termina en fact_optimization.source_env,
# para separar en Power BI los eventos de desarrollo de los reales.
ANALYTICS_ENV=dev

# --- Base de datos ---
# La lee SmartCartDB.__init__. Si falta, se usa el docker-compose local, así que
# para desarrollo se puede dejar comentada.
DATABASE_URL=postgresql://smartuser:smartpassword@localhost:5432/smartcart

# En el servidor de Oracle la línea es casi la misma: Postgres corre en la MISMA
# máquina que la API y que el barrido, así que sigue siendo localhost y no hace
# falta TLS — la conexión no sale por ninguna interfaz de red. Es también por qué
# el 5432 nunca se abre en la security list de OCI.
#
# La API, los scrapers, el orquestador y el DDL resuelven todos por
# `resolve_conn_string()` en src/schema.py: esta es la única línea que hay que
# cambiar para mudar el proyecto entero.

# --- API ---
# Orígenes que pueden llamar a la API, separados por coma. El default (los dos
# puertos del dev server de Vite) sirve para desarrollo sin tocar nada.
#
# En producción va el dominio real y NADA MÁS:
#   CORS_ORIGINS=https://tu-dominio
#
# No existe la opción de poner `*`: el comodín es incompatible con
# allow_credentials y los navegadores lo rechazan.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pipeline de scraping (src/scripts/orchestrator.py) ---

# Dónde escribe el orquestador. Relativo a la raíz del repo si no es absoluto.
SMARTCART_LOG_DIR=logs

# Días de logs a conservar. La limpieza corre al inicio de cada ejecución.
SMARTCART_LOG_RETENTION_DAYS=14

SMARTCART_LOG_LEVEL=INFO

# Borrado de las filas de productos que la tienda ya no ofrece: on | off | dry-run.
# Sin esto, un producto discontinuado queda para siempre con in_stock = TRUE y el
# optimizador lo sigue cotizando. Sólo se poda una tienda que completó su barrido,
# y el borrado se aborta solo si se llevaría más del 30% del catálogo.
SMARTCART_PRUNE=on

# Segundos que el orquestador espera a que Postgres responda antes de abortar con
# rc=2. Cubre el caso del contenedor local todavía levantando; en el servidor la
# unidad ya arranca `After=postgresql.service`, así que el margen sobra.
SMARTCART_DB_WAIT=60

# --- Aviso de fallo (sólo servidor; ver ops/oracle/smartcart-alert@.service) ---
# Topic de ntfy.sh al que systemd manda un push cuando el barrido o la API fallan.
# Gratis y sin cuenta: se elige un nombre y se lo suscribe desde la app de ntfy.
#
# El topic ES el secreto — cualquiera que lo adivine puede mandarte
# notificaciones—, así que va largo y no adivinable, y por eso vive acá y no en
# el archivo de la unidad, que está en el repo.
SMARTCART_NTFY_URL=https://ntfy.sh/smartcart-CAMBIAR-POR-ALGO-LARGO
