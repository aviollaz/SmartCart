# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/
# El venv de Linux que usa el pipeline de cron, aparte del de Windows: los
# binarios no son intercambiables.
.venv-linux/

# Logs del pipeline de scraping (ops/run_pipeline.sh)
logs/
*.log

# Variables de entorno y secretos
.env

# Caché de testing
.pytest_cache/
.coverage

# Archivos temporales de SO y Editores
.vscode/
.idea/
.DS_Store

# Archivos de documentación
# Se ignora el material de referencia (docs/references/ son ~700K de capturas de
# pantalla de las grillas de promos), pero NO los .md: smartcart_spec.md ya
# estaba trackeado desde antes de esta regla y TODO.md tiene que estarlo también.
# Ojo con el patrón: `docs/` a secas excluye el directorio entero y git ni
# siquiera desciende, así que una negación adentro no tendría efecto.
docs/*
!docs/*.md