# A dónde le pega el frontend. Se lee en tiempo de BUILD, no de ejecución: Vite
# reemplaza `import.meta.env.VITE_API_URL` por su valor literal al compilar, así
# que cambiarlo obliga a rehacer `npm run build`. No sirve editarlo en el servidor
# y reiniciar nada.

# Desarrollo: uvicorn en la máquina.
VITE_API_URL=http://localhost:8000

# Producción (ops/oracle/README.md): nginx sirve este build como estático y hace
# de proxy hacia uvicorn bajo /api, así que la URL es del mismo origen.
#
#   VITE_API_URL=https://TU_DOMINIO/api
#
# Que sea el mismo origen es lo que hace que CORS no participe en el camino
# normal. La lista de CORS_ORIGINS del backend sigue haciendo falta igual, para
# el dev server de Vite y para cualquier otro origen que se quiera habilitar.
