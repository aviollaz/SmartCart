# =============================================================================
# SmartCart — scrapeo diario. Instalar con `crontab -e` y pegar lo de abajo,
# reemplazando /home/USUARIO/SmartCart por la ruta real del repo.
#
# Antes de instalar:
#   chmod +x ops/run_pipeline.sh
#   python3 -m venv .venv-linux && . .venv-linux/bin/activate && pip install -r requirements.txt
#   cp .env.example .env   # y completar DATABASE_URL
# =============================================================================

# Cron NO hereda el entorno de la sesión interactiva: su PATH por default es
# mínimo y su shell es /bin/sh. Estas tres líneas evitan la mitad de los
# "en mi terminal anda".
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
MAILTO=""

# -----------------------------------------------------------------------------
# 03:00 todos los días.
#
# flock -n: si la corrida de ayer sigue viva, ésta se saltea en vez de encolarse.
#   Dos pipelines simultáneos compiten por los mismos upserts y, peor, el segundo
#   podría podar con un `seen_skus` a medio armar.
#
# El lockfile va en /tmp (ext4 nativo). NO ponerlo dentro del repo si éste vive
#   bajo /mnt/c: el filesystem 9p con el que WSL monta los discos de Windows no
#   da semántica de lock confiable, que es justo lo único que se le pide.
#
# El redirect de acá es la RED DE SEGURIDAD, no el log principal: run_pipeline.sh
#   toma control de su propia salida en su paso 1. Este archivo normalmente queda
#   vacío; si tiene contenido es porque algo falló ANTES (venv ausente, permisos,
#   shebang) o porque el lock estaba tomado. O sea: que tenga contenido ya es la
#   alerta.
#
# Los `%` van escapados como `\%`. Sin escapar, cron los convierte en newline y
#   trunca el comando — es el error clásico de este archivo.
# -----------------------------------------------------------------------------
0 3 * * * /usr/bin/flock -n /tmp/smartcart_pipeline.lock /home/USUARIO/SmartCart/ops/run_pipeline.sh || echo "$(date -Is) rc=$? (lock tomado o fallo temprano)" >> /home/USUARIO/SmartCart/logs/cron_boot_$(date +\%Y\%m\%d).log 2>&1


# =============================================================================
# WSL2 — leer esto antes de dar por instalado el cron
#
# Acá el job falla por motivos que no tienen nada que ver con el código.
#
# 1. cron tiene que estar corriendo. Depende de si la distro usa systemd
#    (`grep systemd /etc/wsl.conf`):
#
#      con systemd=true  ->  sudo systemctl enable --now cron
#      sin systemd       ->  sudo service cron start, y para que sobreviva a los
#                            reinicios de la VM, en /etc/wsl.conf:
#                                [boot]
#                                command = service cron start
#
#    Verificar con `systemctl is-enabled cron` (debe decir "enabled", no sólo
#    "active": activo ahora no significa que vuelva solo tras un `wsl --shutdown`).
#
# 2. WSL TIENE QUE ESTAR CORRIENDO a las 03:00. Si Windows cerró la VM —cosa que
#    hace sola tras un rato sin uso, y siempre al apagar la máquina— el cron no
#    dispara nunca. Esto no lo arregla ningún script: es cómo funciona WSL.
#    Si se necesita la garantía, la alternativa es disparar desde Windows con el
#    Programador de Tareas:
#
#        Programa:   C:\Windows\System32\wsl.exe
#        Argumentos: -d Ubuntu -- /home/USUARIO/SmartCart/ops/run_pipeline.sh
#        Opciones:   "Ejecutar aunque el usuario no haya iniciado sesión"
#                    "Reactivar el equipo para ejecutar esta tarea"
#
#    Esa tarea levanta la VM si hace falta. Si se usa esta vía, conviene NO tener
#    además la línea de crontab, para no correr el pipeline dos veces.
#
# 3. Docker tiene que estar arriba. El orquestador espera a que Postgres responda
#    (--db-timeout, 60s por default) y si no aparece corta con rc=2 sin scrapear
#    nada. Para que el script levante el contenedor él mismo:
#        SMARTCART_AUTOSTART_DB=1
#    en el .env (apagado por default: levantar servicios a las 3am conviene que
#    sea una decisión explícita).
#
# 4. El venv de Windows no sirve. Tiene Scripts/ y .exe; desde Linux hace falta
#    uno propio (.venv-linux por default, override con SMARTCART_VENV).
#
# 5. Correr el repo desde /mnt/c es varias veces más lento que desde el
#    filesystem nativo de WSL (~/), por el overhead de 9p. Para un job de varios
#    minutos no es bloqueante, pero si el pipeline se hace largo, clonar el repo
#    dentro de ~ es la mejora más barata.
# =============================================================================


# =============================================================================
# Verificación (no esperar hasta mañana a las 3)
#
#   # Disparar a mano, igual que lo haría cron:
#   /usr/bin/flock -n /tmp/smartcart_pipeline.lock /home/USUARIO/SmartCart/ops/run_pipeline.sh
#   echo "rc=$?"
#
#   # Seguir el log estructurado:
#   tail -f /home/USUARIO/SmartCart/logs/orchestrator_$(date +%Y%m%d).log
#
#   # Confirmar que cron efectivamente disparó (Ubuntu/Debian):
#   grep CRON /var/log/syslog | tail
#
#   # Ver las últimas corridas:
#   docker exec smartcart_db psql -U smartuser -d smartcart -c \
#     "SELECT run_id, supermercado, status, items_scraped, duration_seconds, start_time
#        FROM scraper_execution_logs ORDER BY id DESC LIMIT 12;"
#
# Chequeos de salud que conviene mirar cada tanto:
#
#   -- Corridas que arrancaron y nunca cerraron (proceso muerto de golpe)
#   SELECT * FROM scraper_execution_logs
#    WHERE status = 'RUNNING' AND start_time < now() - interval '4 hours';
#
#   -- Tendencia por tienda: una caída brusca del volumen es un scraper roto,
#   -- no menos catálogo
#   SELECT supermercado, date_trunc('day', start_time) AS dia,
#          max(items_scraped) AS items, max(status) AS status
#     FROM scraper_execution_logs
#    GROUP BY 1, 2 ORDER BY 2 DESC, 1;
# =============================================================================
