# Unidad de systemd que dispara el barrido cuando la EC2 arranca.
#
# El schedule NO vive acá: EventBridge Scheduler prende la instancia a las 03:00
# ART, y arrancar ES la señal. Por eso no hay ningún .timer — un timer exigiría
# que la máquina estuviera prendida esperando, que es exactamente el costo que
# esta arquitectura evita (y el mismo problema que tenía el cron bajo WSL).
#
# Instalación:
#   sudo cp ops/aws/smartcart-pipeline.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable smartcart-pipeline.service   # enable, NO start
#
# `enable` sin `start`: lo que se quiere es que corra en el PRÓXIMO arranque.
# Un `start` acá lo dispara ahora y, al terminar, apaga la instancia que estás
# usando para instalarlo.

[Unit]
Description=SmartCart — barrido nocturno de supermercados
# El pipeline es todo tráfico saliente HTTPS más una conexión a RDS: sin la red
# realmente arriba, arranca y falla entero.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root

# El script se ubica solo, pero la unidad fija la raíz explícitamente para que
# un repo clonado en otro lado sea una línea de acá y no una edición del script.
Environment=SMARTCART_ROOT=/opt/smartcart
WorkingDirectory=/opt/smartcart
ExecStart=/opt/smartcart/ops/aws/boot_and_scrape.sh

# Sin timeout de systemd: el watchdog es `timeout` adentro de run_pipeline.sh
# (PIPELINE_TIMEOUT, 2h por default), que manda TERM primero para que el
# orquestador alcance a cerrar su fila de telemetría. Un TimeoutStartSec acá
# mataría el proceso por afuera de ese mecanismo y dejaría la fila en RUNNING.
TimeoutStartSec=0

# No reintentar. Un barrido a medias que arranca de nuevo compite consigo mismo
# por los mismos upserts, y —peor— podría podar con un `seen_skus` incompleto.
# El reintento correcto es mañana a las 03:00.
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
